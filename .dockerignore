# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build output (we build fresh in Docker)
.next
out

# Environment files (passed via Cloud Run substitutions, never baked into image)
.env
.env.*
!.env.example

# Secret material — defense in depth (also in .gitignore)
*.key
*.secret
*.pem
*.p12
*.pfx
*.cert
*.crt
secrets.json
credentials.json
gcp-key.json
*-sa-key.json
service-account*.json
id_rsa
id_rsa.pub

# Git
.git
.gitignore
.githooks/

# Claude Code local artifacts (logs, worktrees, hooks — not needed at runtime)
.claude/

# Other editor/tool dirs
.cursor/
.vercel
cloudbuild.substitutions*.yaml

# IDE
.vscode
.idea
*.swp
*.swo

# Documentation (not needed in production image)
*.md
!README.md
docs/

# Tests
__tests__
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
coverage

# Development files
.eslintrc*
.prettierrc*
tsconfig.tsbuildinfo

# OS files
.DS_Store
Thumbs.db

# Supabase local
.supabase

# Scripts not needed in production
scripts/

# Temporary files
tmp/
temp/
*.tmp
*.bak
